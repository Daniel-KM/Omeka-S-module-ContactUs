msgstr "[ContactUs] Roskapostia havaittu: syyt=%s; ip=%s; sähköposti=%s"

#: src/View/Helper/ContactUs.php:503
msgid "Links (URLs) are not allowed in messages. Please remove any link and resubmit."
msgstr "Linkkejä (URL-osoitteita) ei sallita viesteissä. Poista kaikki linkit ja lähetä viesti uudelleen."

#: src/View/Helper/ContactUs.php:526
msgid "The unsubscription for {email} is confirmed."
msgstr "Osoitteen {email} tilauksen peruminen on vahvistettu."

#: src/View/Helper/ContactUs.php:531
msgid "Thank you for subscribing to our newsletter, {name}."
msgstr "Kiitos uutiskirjeemme tilaamisesta, {name}."

#: src/View/Helper/ContactUs.php:538
msgid "Thank you for your message, {name}. It will be sent to the author as soon as possible."
msgstr "Kiitos viestistäsi, {name}. Se lähetetään tekijälle mahdollisimman pian."

#: src/View/Helper/ContactUs.php:543
msgid "Thank you for your message, {name}. We will answer you as soon as possible."
msgstr "Kiitos viestistäsi, {name}. Vastaamme mahdollisimman pian."

#: src/View/Helper/ContactUs.php:575
msgid "Subscribe newsletter"
msgstr "Tilaa uutiskirje"

