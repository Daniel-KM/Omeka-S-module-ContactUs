msgid "This resource has no author to contact. Contact administor for more information."
msgstr "Tällä resurssilla ei ole tekijää, johon voisi ottaa yhteyttä. Pyydä lisätietoja ylläpitäjältä."

#: src/View/Helper/ContactUs.php:976
