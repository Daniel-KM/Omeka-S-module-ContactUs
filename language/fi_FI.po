msgid "Thank you for your message {name}. Check your confirmation mail. The author will receive it soon."
msgstr "Kiitos viestistäsi, {name}. Tarkista vahvistussähköpostisi. Tekijä saa viestin pian."

#: src/View/Helper/ContactUs.php:699
msgid "Sorry, we are not able to send the email to the author."
msgstr "Valitettavasti sähköpostia ei voida lähettää tekijälle."

#: src/View/Helper/ContactUs.php:724
msgid "Sorry, the message is recorded, but we are not able to notify the admin at once. You may come back later if you don’t receive answer."
msgstr "Valitettavasti viesti tallennettiin, mutta ylläpitäjälle ei voida ilmoittaa siitä heti. Voit palata myöhemmin, jos et saa vastausta."

#: src/View/Helper/ContactUs.php:772
msgid "Sorry, we are not able to send the confirmation email."
msgstr "Valitettavasti vahvistussähköpostia ei voida lähettää."

#: src/View/Helper/ContactUs.php:796
msgid "There is an error."
msgstr "Tapahtui virhe."

#: src/View/Helper/ContactUs.php:859
#, php-format
msgid "About resource %s (%s)."
msgstr "Tietoja resurssista %s (%s)."

#: src/View/Helper/ContactUs.php:940
