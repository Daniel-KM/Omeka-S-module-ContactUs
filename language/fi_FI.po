#: Module.php:146
msgid "The directory \"{directory}\" is not writeable."
msgstr "Hakemistoon \"{directory}\" ei voi kirjoittaa."

#: Module.php:183
msgid ""
"Module ContactUs : SpamGuard is missing, so only simple anti-spam "
"countermeasures are available."
msgstr ""
"ContactUs-lisäosa: SpamGuard puuttuu, joten käytettävissä ovat vain "
"yksinkertaiset roskapostintorjuntatoimet."

#: Module.php:250
msgid "All contact messages and files will be removed (folder \"{folder}\")."
msgstr ""
"Kaikki yhteydenottoviestit ja tiedostot poistetaan (kansio \"{folder}\")."

