msgstr "Darempredit ac'hanomp"

#: src/Form/SiteSettingsFieldset.php:17
msgid "Old themes"
msgstr "Temoù kozh"

#: src/Form/SiteSettingsFieldset.php:35 src/Form/SettingsFieldset.php:34
#: src/Form/ContactUsFieldset.php:28 src/Form/NewsletterFieldset.php:27
