<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \ContactUs\Api\Representation\MessageRepresentation[] $messages
 * @var \ContactUs\Api\Representation\MessageRepresentation[] $resources
 * @var \ContactUs\Form\QuickSearchForm $formSearch
 * @var \Omeka\Form\ConfirmForm $formDeleteSelected
 * @var \Omeka\Form\ConfirmForm $formDeleteAll
 * @var \Omeka\Form\ConfirmForm $formResendSelected
 * @var \Omeka\Form\ConfirmForm $formResendAll
 * @var int $countResendable
 */

use ContactUs\Api\Adapter\MessageAdapter;

$plugins = $this->getHelperPluginManager();
$url = $plugins->get('url');
$i18n = $plugins->get('i18n');
$escape = $plugins->get('escapeHtml');
$assetUrl = $plugins->get('assetUrl');
$translate = $plugins->get('translate');
$hyperlink = $plugins->get('hyperlink');
$escapeAttr = $plugins->get('escapeHtmlAttr');
$userIsAllowed = $plugins->get('userIsAllowed');

$this->headLink()
    ->appendStylesheet($assetUrl('css/common-page-action-menu.css', 'Common'))
    ->appendStylesheet($assetUrl('css/common-quick-search.css', 'Common'))
    ->appendStylesheet($assetUrl('css/common-dialog.css', 'Common'))
    ->appendStylesheet($assetUrl('css/contact-us-admin.css', 'ContactUs'));
$this->headScript()
    ->appendFile($assetUrl('js/common-quick-search.js', 'Common'), 'text/javascript', ['defer' => 'defer'])
    ->appendFile($assetUrl('js/common-dialog.js', 'Common'), 'text/javascript', ['defer' => 'defer'])
    ->appendFile($assetUrl('js/common-page-action-menu.js', 'Common'), 'text/javascript', ['defer' => 'defer'])
    ->appendFile($assetUrl('js/contact-us-admin.js', 'ContactUs'), 'text/javascript', ['defer' => 'defer']);

$this->htmlElement('body')->appendAttribute('class', 'contact-message contact-messages browse');

$sortHeadings = [
    [
        'label' => $translate('Sender name'),
        'value' => 'name',
    ],
    [
        'label' => $translate('Sender email'),
        'value' => 'email',
    ],
    [
        'label' => $translate('Date sent'),
        'value' => 'created',
    ],
];

$batchEditRight = $userIsAllowed(MessageAdapter::class, 'batch-update')
    || $userIsAllowed(MessageAdapter::class, 'batch-delete');
$editRight = $userIsAllowed(MessageAdapter::class, 'update')
    || $userIsAllowed(MessageAdapter::class, 'delete');
?>

<?= $this->pageTitle('', 1, $translate('Contact messages')) ?>

<?= $this->searchFilters() ?>

 <div class="browse-controls">
    <?= $this->pagination() ?>
    <button type="button" class="button search quick-search"><?= $escape($translate('Quick filter')) ?></button>
    <?= $this->sortSelector($sortHeadings) ?>
</div>

<?php if ($messages): ?>
<form method="post" id="batch-form" class="disable-unsaved-warning">
<div id="page-actions">
    <?php if ($userIsAllowed(MessageAdapter::class, 'batch-update')): ?>
    <div class="page-action-menu">
        <div class="with-sub-menu">
            <a href="#" class="button expand"
                aria-label="<?= $escapeAttr($translate('Expand')) ?>"
                title="<?= $escapeAttr($translate('Expand')) ?>"><?= $escape($translate('Actions')) ?></a>
            <ul class="collapsible">
                <li><a href="#"
                    class="batch-actions batch-property"
                    data-batch-property-url="<?= $escapeAttr($url('admin/contact-message/default', ['action' => 'batch-set-read'], true)) ?>"
                    data-property="is_read"
                    data-status="read"><?= $escape($translate('Set read')) ?></a></li>
                <li><a href="#"
                    class="batch-actions batch-property"
                    data-batch-property-url="<?= $escapeAttr($url('admin/contact-message/default', ['action' => 'batch-set-not-read'], true)) ?>"
                    data-property="is_read"
                    data-status="not-read"><?= $escape($translate('Set not read')) ?></a></li>
                <li><a href="#"
                    class="batch-actions batch-property"
                    data-batch-property-url="<?= $escapeAttr($url('admin/contact-message/default', ['action' => 'batch-set-spam'], true)) ?>"
                    data-property="is_spam"
                    data-status="spam"><?= $escape($translate('Set spam')) ?></a></li>
                <li><a href="#"
                    class="batch-actions batch-property"
                    data-batch-property-url="<?= $escapeAttr($url('admin/contact-message/default', ['action' => 'batch-set-not-spam'], true)) ?>"
                    data-property="is_spam"
                    data-status="not-spam"><?= $escape($translate('Set not spam')) ?></a></li>
                <li class="menu-group">
                    <span class="menu-group-label" id="contact-message-menu-maintenance"><?= $escape($translate('Maintenance')) ?></span>
                    <ul aria-labelledby="contact-message-menu-maintenance">
                        <li><a href="#"
                            class="sidebar-content resend-selected"
                            data-sidebar-selector="#sidebar-resend-selected"><?= $escape($translate('Resend selected messages to the author…')) ?></a></li>
                        <li><a href="#"
                            class="sidebar-content resend-all"
                            data-sidebar-selector="#sidebar-resend-all"><?= $escape($translate('Resend all messages to the author…')) ?></a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
    <?php endif; ?>
    <?php if ($userIsAllowed(MessageAdapter::class, 'batch-delete')): ?>
    <a href="#"
        class="button delete batch-actions sidebar-content"
        data-sidebar-selector="#sidebar"
        data-sidebar-content-url="<?= $escapeAttr($url('admin/contact-message/default', ['action' => 'batch-delete-confirm'], true)) ?>"
        aria-label="<?= $escapeAttr($translate('Delete')) ?>"
        title="<?= $escapeAttr($translate('Delete')) ?>"><?= $escape($translate('Delete')) ?></a>
    <?php endif; ?>
</div>
<?php endif; ?>

<?php $this->trigger('view.browse.before'); ?>
<?php if (empty($messages)): ?>
<div class="no-resources">
    <p><?= $translate('There are no messages.') ?></p>
</div>
<?php $this->trigger('view.browse.after'); ?>

<?php else: ?>
<table class="tablesaw <?php if ($batchEditRight): echo 'batch-edit'; endif ?>" data-tablesaw-mode="stack">
    <thead>
        <tr>
            <th class="column-tag">
                <?php if ($batchEditRight): ?>
                <input type="checkbox" class="select-all" aria-label="<?= $translate('Select all') ?>">
                <?php endif; ?>
                <?= $translate('Message') ?>
            </th>
            <th><?= $translate('Sender') ?></th>
            <th><?= $translate('Date sent') ?></th>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($messages as $message): ?>
        <?php
        $owner = $message->owner();
        ?>
        <tr class="contact-message">
            <td>
                <?php if ($batchEditRight): ?>
                    <input type="checkbox" name="resource_ids[]" value="<?= $message->id() ?>" aria-label="<?= $translate('Select message') ?>">
                <?php endif; ?>
                <?php $subject = $message->subject() ?: $message->body() ?>
                <?= $escape(mb_substr($subject, 0, 200)) . (mb_strlen($subject) > 200 ? '…' : '') ?>
                <?php if ($message->isToAuthor()): ?>
                <span class="o-icon-user" aria-label="<?= $translate('Message to author') ?>"></span>
                <?php endif; ?>
                <ul class="actions">
                    <?php $editRightContactUs = $message->userIsAllowed('update'); ?>
                    <?php if ($editRightContactUs): ?>
                    <li><a href="#"
                        class="toggle-property is_read o-icon-<?= $message->isRead() ? 'read' : 'not-read' ?>"
                        data-toggle-url="<?= $escapeAttr($message->url('toggle-read')) ?>"
                        data-property="is_read"
                        data-status="<?= $message->isRead() ? 'read' : 'not-read' ?>"
                        aria-label="<?= $escapeAttr($translate('Toggle read')) ?>"
                        title="<?= $escapeAttr($translate('Toggle read')) ?>"></a></li>
                    <li><a href="#"
                        class="toggle-property is_spam o-icon-<?= $message->isSpam() ? 'spam' : 'not-spam' ?>"
                        data-toggle-url="<?= $escapeAttr($message->url('toggle-spam')) ?>"
                        data-property="is_spam"
                        data-status="<?= $message->isSpam() ? 'spam' : 'not-spam' ?>"
                        aria-label="<?= $escapeAttr($translate('Toggle spam')) ?>"
                        title="<?= $escapeAttr($translate('Toggle spam')) ?>"></a></li>
                    <?php if ($message->isToAuthor()): ?>
                    <?php if ($resent = $message->resent()): ?>
                    <li><span class="resent fas fa-paper-plane"
                        aria-label="<?= $v = $escapeAttr(sprintf($translate('Resent to the author: %s'), $i18n->dateFormat($resent, 'medium', 'short'))) ?>"
                        title="<?= $v ?>"></span></li>
                    <?php elseif ($message->isBlocked()): ?>
                    <li><a href="#"
                        class="resend-message fas fa-paper-plane"
                        data-resend-url="<?= $escapeAttr($message->url('resend')) ?>"
                        aria-label="<?= $v = $escapeAttr($translate('Resend to the author (false positive)')) ?>"
                        title="<?= $v ?>"></a></li>
                    <?php endif; ?>
                    <?php endif; ?>
                    <?php if ($message->email()): ?>
                    <li><button type="button"
                        class="button-dialog-common reply-message fas fa-envelope"
                        aria-haspopup="dialog" aria-controls="dialog-contactus-send" data-dialog-selector="dialog.dialog-send-message.dialog-contactus"
                        data-url="<?= $escapeAttr($message->url('send-message')) ?>"
                        aria-label="<?= $v = $escapeAttr($translate('Reply to the contact')) ?>"
                        title="<?= $v ?>"></button></li>
                    <?php endif; ?>
                    <?php endif; ?>
                    <?php if ($editRightContactUs && $message->hasZip()): ?>
                    <li><a href="<?= $escapeAttr($message->zipUrl()) ?>"
                        class="o-icon-zip download-zip"
                        download="download" target="_self"
                        aria-label="<?= $v = $escapeAttr($translate('Download files as zip')) ?>"
                        title="<?= $v ?>"></a></li>
                    <?php endif; ?>
                    <?php if ($message->userIsAllowed('delete')): ?>
                    <li><a href="#"
                        class="o-icon-delete sidebar-content"
                        data-sidebar-selector="#sidebar"
                        data-sidebar-content-url="<?= $escapeAttr($message->url('delete-confirm')) ?>"
                        aria-label="<?= $escapeAttr($translate('Delete')) ?>"
                        title="<?= $escapeAttr($translate('Delete')) ?>"></a></li>
                    <?php endif; ?>
                    <li><a href="#"
                        data-sidebar-selector="#sidebar"
                        data-sidebar-content-url="<?= $escapeAttr($message->url('show-details')) ?>"
                        class="o-icon-more sidebar-content"
                        aria-label="<?= $escapeAttr($translate('Details')) ?>"
                        title="<?= $escapeAttr($translate('Details')) ?>"></a></li>
                </ul>
            </td>
            <td>
                <?php if ($owner): ?>
                <span class="message-email"><?= $hyperlink($owner->name(), $url('admin/id', ['controller' => 'user', 'action' => 'show', 'id' => $owner->id()])) ?></span>
                <?php else: ?>
                <span class="message-email message-public"><?= $hyperlink($message->name() ?: $message->email(), 'mailto:' . $message->email()) ?></span>
                <span class="o-icon-users" aria-label="<?= $translate('Public') ?>"></span>
                <?php endif; ?>
            </td>
            <td><?= $escape($i18n->dateFormat($message->created(), 'medium', 'medium')) ?></td>
        </tr>
        <?php endforeach; ?>
    </tbody>
</table>

</form>

<?php $this->trigger('view.browse.after') ?>
<div class="browse-controls">
    <?= $this->pagination() ?>
</div>

<div id="sidebar" class="sidebar">
    <a href="#"
        class="sidebar-close o-icon-close"
        aria-label="<?= $escapeAttr($translate('Close')) ?>"
        title="<?= $escapeAttr($translate('Close')) ?>"></a>
    <div class="sidebar-content"></div>
</div>

<?php if ($userIsAllowed(MessageAdapter::class, 'batch-update')): ?>
<div id="sidebar-resend-selected" class="sidebar">
    <a href="#"
        class="sidebar-close o-icon-close"
        aria-label="<?= $escapeAttr($translate('Close')) ?>"
        title="<?= $escapeAttr($translate('Close')) ?>"></a>
    <div class="sidebar-content">
        <div class="sidebar-resend">
            <h3><?= $escape($translate('Resend to the author')) ?></h3>
            <p><?= sprintf($escape($translate('Resend the %s selected messages to the author of their resource, without any check of spam?')), '<strong class="resend-count">0</strong>') ?></p>
            <p><?= $escape($translate('Only the messages blocked as spam are resent and set as not spam: messages already sent, already resent or to us are skipped. The process runs in background.')) ?></p>
            <?= $this->form($formResendSelected) ?>
        </div>
    </div>
</div>

<div id="sidebar-resend-all" class="sidebar">
    <a href="#"
        class="sidebar-close o-icon-close"
        aria-label="<?= $escapeAttr($translate('Close')) ?>"
        title="<?= $escapeAttr($translate('Close')) ?>"></a>
    <div class="sidebar-content">
        <div class="sidebar-resend">
            <h3><?= $escape($translate('Resend to the author')) ?></h3>
            <p><?= sprintf($escape($translate('Resend to the author the %s messages blocked as spam of the current results, on all pages, without any check of spam?')), '<strong>' . (int) $countResendable . '</strong>') ?></p>
            <p><?= $escape($translate('The messages will be set as not spam. Messages already sent, already resent or to us are skipped. The process runs in background.')) ?></p>
            <?= $this->form($formResendAll) ?>
        </div>
    </div>
</div>
<?php endif; ?>

<script>
// Complete the batch delete form after confirmation.
$('.sidebar').on('submit', '#batch-delete-confirm', function(e) {
    var confirmForm = $(this);
    if (confirmForm.hasClass('batch-delete-all')) {
        confirmForm.append($('.batch-query').clone());
    } else {
        $('#batch-form').find('input:checked').each(function() {
            confirmForm.append($(this).clone().attr('type', 'hidden'));
        });
    }
});
</script>
<?php endif; ?>

<?= $this->partial('common/quick-search-sidebar', [
    'formSearch' => $formSearch,
    'title' => $translate('Filter contact messages'),
]) ?>

<?= $this->partial('common/dialog/contact-us-send-message', [
    'form' => $formSendMessage,
]) ?>
